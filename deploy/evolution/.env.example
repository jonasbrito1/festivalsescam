# =============================================================================
# Modelo. Copie para .env no servidor e preencha os dois segredos.
#
#   cp .env.example .env
#
# O .env real NUNCA é versionado (o repositório é público).
# =============================================================================

# ---------------------------------------------------------------------------
# ACESSO
# ---------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
# É esta chave que vai em "Chave do gateway" na tela de Configurações.
AUTHENTICATION_API_KEY=TROQUE_ISTO

# Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=TROQUE_ISTO_TAMBEM

# Endereço por onde a própria API se referencia. Local, porque ninguém de fora
# fala com ela.
SERVER_URL=http://127.0.0.1:8088

# ---------------------------------------------------------------------------
# BANCO
# ---------------------------------------------------------------------------
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=festival

# A URI de conexão NÃO fica aqui: ela é montada no docker-compose.yml, que é o
# único lugar onde ${POSTGRES_PASSWORD} é de fato substituído. Assim a senha
# aparece uma vez só — na linha acima.

# Guarda a sessão — sem isto o QR teria de ser lido a cada reinício.
DATABASE_SAVE_DATA_INSTANCE=true

# ---------------------------------------------------------------------------
# O QUE NÃO GUARDAR — leia antes de mudar
#
# Por padrão a Evolution grava TUDO que passa pelo número conectado: cada
# mensagem recebida, cada contato da agenda, o histórico inteiro das conversas.
# O número do festival é institucional e recebe mensagem de terceiros; guardar
# esse conteúdo num Postgres nosso cria um depósito de dado pessoal que nunca
# vamos usar, que ninguém consentiu, e que teríamos de proteger. Nós só
# PRECISAMOS enviar.
#
# Deixe tudo em false.
# ---------------------------------------------------------------------------
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# ---------------------------------------------------------------------------
# CACHE
# ---------------------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution-festival
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---------------------------------------------------------------------------
# SESSÃO
# ---------------------------------------------------------------------------
# É o nome que aparece em "Aparelhos conectados" no celular. Quem for
# desconectar por engano ao menos vai saber o que está desconectando.
CONFIG_SESSION_PHONE_CLIENT=Festival de Calouros
CONFIG_SESSION_PHONE_NAME=Chrome

# Não apagar a instância sozinha quando a conexão cair: a sessão precisa
# sobreviver a uma noite de internet ruim sem exigir QR novo.
DEL_INSTANCE=false
QRCODE_LIMIT=30

# ---------------------------------------------------------------------------
# LOG
# ---------------------------------------------------------------------------
# ERROR e não DEBUG de propósito: em DEBUG a Evolution despeja o conteúdo das
# mensagens no log do contêiner.
LOG_LEVEL=ERROR
LOG_BAILEYS=error
LOG_COLOR=false
TELEMETRY_ENABLED=false
